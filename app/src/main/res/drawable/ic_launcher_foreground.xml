<?xml version="1.0" encoding="utf-8"?>
<!--
    Meshlit adaptive launcher foreground.
    Layer: 108 x 108 dp. Safe zone is the central 72 x 72 dp; all content
    is placed inside that region (and shifted inward by 18 dp on each side).
    Design: a Brain node (violet) at the center with 3 satellite nodes
    connected by light beams. Reads as "cluster" at any launcher mask shape.

    Phase v2 — retinted to the Pulse palette:
      - top satellite:         aqua   #4DD9C0
      - bottom-left satellite: coral  #E8735F
      - bottom-right satellite: violet #7C6FF2
      - Brain node fill: violet radial gradient (unchanged — Brain
        stays the brand anchor)
    The cyan/emerald colors used by the v1 build are preserved as
    `ic_launcher_foreground_v1.xml` for the v1 flavor's monochrome
    themed-icon path. The new launcher icon (this file) ships in
    both flavors so QA can install v1 and v2 side-by-side and see
    distinct icons.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Light beams: Brain -> satellites. Drawn first so nodes overlay them. -->
    <!-- Brain(54,54) -> Satellite top (54,30) -->
    <path
        android:strokeColor="#FF4DD9C0"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.85"
        android:fillColor="#00000000"
        android:pathData="M54,54 L54,30" />
    <!-- Brain(54,54) -> Satellite bottom-left (30,66) -->
    <path
        android:strokeColor="#FFE8735F"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.85"
        android:fillColor="#00000000"
        android:pathData="M54,54 L30,66" />
    <!-- Brain(54,54) -> Satellite bottom-right (78,66) -->
    <path
        android:strokeColor="#FF7C6FF2"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.85"
        android:fillColor="#00000000"
        android:pathData="M54,54 L78,66" />

    <!-- Faint orbital ring around the Brain, reinforcing the "central mind" -->
    <path
        android:strokeColor="#447C6FF2"
        android:strokeWidth="1.0"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-14,0 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0" />

    <!-- Satellite: aqua (top) -->
    <path
        android:fillColor="#FF4DD9C0"
        android:pathData="M54,30 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <!-- Satellite inner highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M52.5,28.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />

    <!-- Satellite: coral (bottom-left) -->
    <path
        android:fillColor="#FFE8735F"
        android:pathData="M30,66 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M28.5,64.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />

    <!-- Satellite: violet (bottom-right) -->
    <path
        android:fillColor="#FF7C6FF2"
        android:pathData="M78,66 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M76.5,64.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0" />

    <!-- Brain node (violet) at center, drawn last so it sits on top of beams -->
    <path android:pathData="M54,54 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="7"
                android:startColor="#FFB7A4FF"
                android:endColor="#FF5B3DD8" />
        </aapt:attr>
    </path>
    <!-- Brain inner highlight -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillAlpha="0.7"
        android:pathData="M51,51 m-1.8,0 a1.8,1.8 0 1,0 3.6,0 a1.8,1.8 0 1,0 -3.6,0" />
</vector>
