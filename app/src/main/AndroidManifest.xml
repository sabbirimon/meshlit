<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network: discovery, transport, and the embedded HTTP/SSE server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!-- Foreground service: needed for inference/MCP to survive backgrounding.
         dataSync is the closest fit for "long-running job queue" and is
         capped at 6h/24h on Android 15+ — handled with onTimeout(). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Optional: cellular data for remote nodes (gated on user opt-in). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Bluetooth peripheral probe (Phase 0.5 device profile).
         BLUETOOTH_CONNECT is required from API 31+; the scan/admin
         pair is for legacy Bluetooth Classic discovery. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- ADB for development flow only. The product keeps the ADB-debug flow
         out of the user-facing build. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Storage / media. Modern Android (13+) split media into per-type
         grants; legacy READ/WRITE_EXTERNAL_STORAGE covers older devices.
         Without these, the system Settings → Apps → Meshlit only shows 4
         permission groups even though the app imports models from disk
         and saves log/code exports. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Android 14+: lets the user grant "selected photos" instead of
         full photo library access. Meshlit uses this when the Agent
         screen lets the user attach an image to a prompt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <!-- Microphone capture for the Voice screen (Phase 2.x — STT/TTS/VAD).
         The core-inference library also declares this in its manifest, but
         the app needs it here so the runtime grant appears under the app's
         permission list rather than the SDK's. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phase Cloud 2 — on-device agent capabilities. Each permission is
         optional (the user must opt in via Settings → Cloud → Agent
         capabilities AND grant the runtime permission). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Battery-optimization whitelist. Required so the
         ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS intent (fired by the
         first-run setup wizard on Samsung One UI / MIUI / EMUI) doesn't
         get rejected. Google Play policy restricts the auto-request flow
         to VoIP / alarm-clock apps; we surface it as a manual action. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Phase Observability 1 — opt-in device-wide packet capture.
         BIND_VPN_SERVICE is a signature permission: only the system can
         bind the in-app MeshlitCaptureVpnService. The user enables it
         via the system "VPN profile" consent dialog fired from the
         Network monitor screen. Same gating as Tasker / NetGuard.
         FOREGROUND_SERVICE_SPECIAL_USE is the official FGS type for the
         packet-capture foreground service on Android 14+ (API 34). -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <!-- For Wi-Fi Direct / Aware discovery on supporting devices. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".MeshlitApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Meshlit"
        android:usesCleartextTraffic="true"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Meshlit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Foreground service for hosting inference / MCP tool serving.
             Android 14+ requires foregroundServiceType="dataSync". -->
        <service
            android:name=".inference.InferenceForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Cloud-MCP SSE foreground service — keeps the agentic
             loop's connection alive when the user backgrounds the
             app. Same type as the inference FGS. -->
        <service
            android:name="com.meshlit.core.cloudmcp.CloudMcpForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- AccessibilityService for the Android in-app automation
             tools (app_list / app_open / app_click / app_type / etc.).
             The user opts in via Settings → Cloud → Android automation,
             which routes to Settings.ACTION_ACCESSIBILITY_SETTINGS.
             Behind feature.cloud.android_automation — when the flag is
             off, the agent loop never exposes the app_* tools and the
             service is a no-op. The service uses Google's official
             Android UI Automator library for cross-app node traversal
             (same library the Espresso / Compose-test framework uses). -->
        <service
            android:name="com.meshlit.core.cloudmcp.android.MeshlitAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Phase Observability 1 — opt-in device-wide packet capture
             (the network monitor). The user enables this via the
             Network monitor screen; the system prompts for the VPN
             profile consent. ForegroundServiceType=specialUse is the
             only allowed type for in-app capture on Android 14+; we
             declare the explanation in res/xml/vpn_service_config.xml. -->
        <service
            android:name="com.meshlit.core.net.capture.MeshlitCaptureVpnService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Phase M.4 — share exported log files via FileProvider so the
             receiver app can read them. Authority must match the one used
             by `LogScreen.exportLogs`. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
