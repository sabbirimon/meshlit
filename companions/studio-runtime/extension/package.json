      },
      {
        "command": "meshlit.workspaces",
        "title": "Meshlit: Workspaces"
      },
      {
        "command": "meshlit.workspaceAgents",
        "title": "Meshlit: Workspace Agents"
      },
      {
        "command": "meshlit.bots",
        "title": "Meshlit: Bots"
      },
      {
        "command": "meshlit.llmSettings",
        "title": "Meshlit: LLM Settings"
      },
      {
        "command": "meshlit.openIde",
        "title": "Meshlit: Open IDE"
      },
      {
        "command": "meshlit.startupView",
        "title": "Meshlit: Startup View"
      },
      {
        "command": "meshlit.forgetUsageUnlock",
        "title": "Meshlit: Forget Saved Usage Unlock"
      },
      {
        "command": "meshlit.agent",
