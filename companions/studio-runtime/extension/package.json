{
  "name": "meshlit-workbench",
  "displayName": "Meshlit",
  "publisher": "meshlit",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "Apache-2.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
