{
  "name": "meshlit-workbench",
  "displayName": "Meshlit",
  "publisher": "meshlit",
  "version": "0.3.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "license": "Apache-2.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "meshlit.chat",
        "title": "Meshlit: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "meshlit.agent",
        "title": "Meshlit: New Coding Agent",
        "icon": "$(code)"
      },
      {
        "command": "meshlit.unlockUsage",
        "title": "Meshlit: Unlock Usage"
      },
      {
        "command": "meshlit.usage",
        "title": "Meshlit: Usage and Budgets"
      },
      {
        "command": "meshlit.addConnection",
        "title": "Meshlit: Add Model Connection"
      },
      {
        "command": "meshlit.addMcp",
        "title": "Meshlit: Add MCP Connector"
      },
      {
        "command": "meshlit.home",
        "title": "Meshlit: Home"
      },
      {
        "command": "meshlit.models",
        "title": "Meshlit: Model Connections"
      },
      {
        "command": "meshlit.connectors",
        "title": "Meshlit: MCP Directory"
      },
      {
        "command": "meshlit.checkConnection",
        "title": "Meshlit: Check API Connection"
      },
      {
        "command": "meshlit.gateway.OmniRoute",
        "title": "Meshlit: OmniRoute Dashboard"
      },
      {
        "command": "meshlit.gateway.FreeLLMAPI",
        "title": "Meshlit: FreeLLMAPI Dashboard"
      },
      {
        "command": "meshlit.deepseekHarness",
        "title": "Meshlit: DeepSeek Harness"
      },
      {
        "command": "meshlit.addModelSource",
        "title": "Meshlit: Choose Model Source"
      },
      {
        "command": "meshlit.protocols",
        "title": "Meshlit: APIs and Protocols"
      },
      {
        "command": "meshlit.appAccess",
        "title": "Meshlit: Agent App Access"
      },
      {
        "command": "meshlit.stopAppAccess",
        "title": "Meshlit: Stop All App Access"
      },
      {
        "command": "meshlit.gateway.Hugging Face",
        "title": "Meshlit: Hugging Face Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "meshlit.chat"
        },
        {
          "command": "meshlit.agent"
        }
      ],
      "view/title": [
        {
          "command": "meshlit.chat",
          "when": "view == meshlit.sessions",
          "group": "navigation@1"
        },
        {
          "command": "meshlit.agent",
          "when": "view == meshlit.sessions",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "meshlit",
          "title": "Meshlit",
          "icon": "media/meshlit.svg"
        }
      ]
    },
    "views": {
      "meshlit": [
        {
          "id": "meshlit.navigation",
          "name": "Studio"
        },
        {
          "id": "meshlit.sessions",
          "name": "Chats & agents"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "meshlit.sessions",
        "contents": "Chat while coding agents work.\n[New chat](command:meshlit.chat)\n[New coding agent](command:meshlit.agent)\n[Unlock usage](command:meshlit.unlockUsage)\n[Add model connection](command:meshlit.addConnection)\n[Add MCP connector](command:meshlit.addMcp)"
      }
    ],
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.colorTheme": "Meshlit Dark",
      "workbench.activityBar.location": "default",
      "workbench.browser.dataStorage": "ephemeral",
      "workbench.browser.enableChatTools": false
    },
    "themes": [
      {
        "label": "Meshlit Dark",
        "uiTheme": "vs-dark",
        "path": "./media/dark.json"
      }
    ]
  }
}
