# Release keystore template.
#
# Phase 7 — operators fill in the four fields below and copy this
# file to `~/.gradle/meshlit-release.properties` (NOT into the
# repository — the path lives outside any clone). `app/build.gradle.kts`
# reads the file at build time; if it's missing the release build
# falls back to debug signing so local smoke tests still produce an
# installable APK.
#
# DO NOT commit the populated file. `.gitignore` excludes both the
# file at the home path and any `.jks` / `.keystore` artefact in
# the repo.
#
# Generate a keystore with:
#
#   keytool -genkey -v \
#     -keystore ~/.gradle/meshlit-release.jks \
#     -alias meshlit \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Store the password in a password manager; the keystore file lives
# outside the repo (`~/.gradle/`) so a clone leak doesn't expose it.

# Absolute path to the keystore file (e.g. /Users/me/.gradle/meshlit-release.jks)
storeFile=
# Password for the keystore (set during keytool -genkey)
storePassword=
# Alias inside the keystore (matches -alias above)
keyAlias=
# Password for the specific alias (can equal storePassword)
keyPassword=