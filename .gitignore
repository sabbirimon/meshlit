# Android
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
javadoc/

# Phase 7 — release signing material. Production keystores must never
# land in the repo. The release captain populates
# `~/.gradle/meshlit-release.properties` (template at
# `keystore.properties.example` in the repo root) outside any clone.
*.jks
*.keystore
meshlit-release.properties

# Native
*.o
*.so
*.lo
*.la

# Logs
*.log

# Puku CLI runtime state
.puku-cli/

# Generated icon source (keep generated WebPs, drop the script)
/tmp/gen_icons.py

# Python cache
__pycache__/
*.pyc

# Bundled GGUF starter model. Tracked elsewhere as a release
# artefact — see app/src/main/assets/models/README.md for the
# SHA-256-pinned download command.
app/src/main/assets/models/*.gguf

# Local capture / screenshot artifacts (regenerated from the device)
Screenshots/

# Vendored third-party trees — kept locally for development but
# not shipped. See vendored/README.md for the populate commands.
vendored/upstream/
vendored/runanywhere-kotlin/

# Reference material (Stitch mockups) — kept locally for design
# reviews; not part of the runtime codebase.
stitch/
stitch.zip

# Imported GGUF copies the user drops into the app at runtime. Tracked
# elsewhere as a release artefact.
app/imported-models/
# Keep only dependency pins/documentation/notices; upstream clones stay local.
vendored/*
!vendored/README.md
!vendored/sources.lock.json
!vendored/licenses/

# Optional source trees and Python companion environments
vendored/runanywhere-llama/
vendored/on-device-browser-agent/
companions/crawler/.venv/

# Kotlin local compiler state
.kotlin/

# HarmonyOS NEXT tooling outputs and local signing/SDK configuration
**/.hvigor/
**/oh_modules/
ohosApp/hvigor/node_modules/
ohosApp/signing-config*.json5
*.p12
*.p7b
*.hap
*.app

# JVM crash dumps can contain memory-resident secrets and are never source.
*.hprof
