+struct meshlit_scalar_args { uint k, m, n, type; ulong a_row, b_row; };
+kernel void kernel_meshlit_scalar_matmul(constant meshlit_scalar_args &args [[buffer(0)]],
+        device const char *a [[buffer(1)]], device const char *b [[buffer(2)]],
+        device float *output [[buffer(3)]], uint2 pos [[thread_position_in_grid]]) {
+    if (pos.x >= args.m || pos.y >= args.n) return;
+    device const char *row = a + ulong(pos.x)*args.a_row;
+    device const float *x = (device const float *)(b + ulong(pos.y)*args.b_row);
+    float sum = 0.0f;
+    if (args.type == 0) {
+        for (uint i=0; i<args.k; ++i) sum += ((device const float *)row)[i]*x[i];
+    } else if (args.type == 1) {
+        for (uint i=0; i<args.k; ++i) sum += float(((device const half *)row)[i])*x[i];
+    } else {
+        for (uint i=0; i<args.k; i+=16) {
+            float4x4 decoded;
+            if (args.type == 12) dequantize_q4_K((device const block_q4_K *)row+i/256, short((i%256)/16), decoded);
+            else dequantize_q6_K((device const block_q6_K *)row+i/256, short((i%256)/16), decoded);
+            for (uint j=0; j<16; ++j) sum += decoded[j/4][j%4]*x[i+j];
+        }
+    }
+    output[ulong(pos.y)*args.m+pos.x] = sum;
